# Environment Configuration for AI Threat Modeler

# Backend Configuration
BACKEND_PORT=8000
AEGIS_THREAT_ANALYSIS_CONCURRENCY=2
AEGIS_THREAT_ANALYSIS_TIMEOUT_SECONDS=300

# Frontend Configuration
FRONTEND_PORT=5173

# API URL (used by frontend to connect to backend)
VITE_API_URL=http://127.0.0.1:8000

# Optional review-only local SLM. The model must already be available locally.
# Leave blank to use deterministic analysis and the semantic challenger only.
AEGIS_THREAT_LOCAL_SLM_MODEL=
AEGIS_THREAT_LOCAL_SLM_TASK=text2text-generation

# Local retrieval profile: fast, balanced, or accuracy. Balanced uses BGE Base,
# BM25, reciprocal-rank fusion, and the lightweight security-feature reranker.
AEGIS_THREAT_RETRIEVAL_PROFILE=balanced
# Leave blank to prefer a promoted local security checkpoint when present,
# otherwise balanced mode uses BAAI/bge-base-en-v1.5.
AEGIS_THREAT_EMBEDDING_MODEL=
AEGIS_THREAT_RERANKER_MODEL=disabled
AEGIS_THREAT_CLASSIFIER_EMBEDDING_MODEL=all-MiniLM-L6-v2

# Accuracy mode enables BAAI/bge-reranker-base. It is substantially slower on
# CPU and can also be selected explicitly with AEGIS_THREAT_RERANKER_MODEL.
# After a promoted fine-tune, AEGIS_THREAT_EMBEDDING_MODEL can point to the
# local backend/models/aegis-bge-security-v1 directory.

# Models are offline during analysis. Enable downloads only for the separate
# prefetch step, never for the running service.
AEGIS_THREAT_MODEL_CACHE=
AEGIS_THREAT_ALLOW_MODEL_DOWNLOAD=0

# Optional rank-fusion tuning. Defaults come from the selected profile.
# AEGIS_THREAT_DENSE_WEIGHT=0.62
# AEGIS_THREAT_LEXICAL_WEIGHT=0.38
