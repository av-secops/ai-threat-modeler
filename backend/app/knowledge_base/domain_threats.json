    {
        "id": "DOM-K8S-001",
        "category": "Elevation of Privilege",
        "resource_type": [
            "Service"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "deployment",
                        "op": "==",
                        "value": "k8s"
                    },
                    {
                        "field": "pod_security_enforced",
                        "op": "==",
                        "value": false
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "medium"
        },
        "threat": {
            "title": "Kubernetes pod security enforcement disabled",
            "description": "The workload explicitly lacks pod security enforcement. Review admission restrictions and workload privileges; this gap alone does not prove container escape. The removed PodSecurityPolicy API is not required."
        },
        "risk": {
            "severity": "High",
            "likelihood": "Low",
            "impact": "Critical",
            "risk_score": 78.0,
            "affected_assets": [
                "Kubernetes Cluster",
                "All Services"
            ],
            "business_impact": [
                "Full System Compromise"
            ]
        },
        "mitigation": {
            "primary": "Implement Pod Security Standards (restricted profile) and RBAC.",
            "defense_in_depth": [
                "Network policies",
                "Service mesh",
                "Runtime security"
            ],
            "verification": "Test with privilege escalation exploits."
        },
        "references": [
            "Kubernetes Security Best Practices",
            "CIS Kubernetes Benchmark"
        ],
        "tags": [
            "kubernetes",
            "container",
            "privilege-escalation"
        ]
    },
