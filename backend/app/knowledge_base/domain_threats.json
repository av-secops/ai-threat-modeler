[
    {
        "id": "IOT-001",
        "category": "Tampering",
        "resource_type": [
            "IoT Device",
            "Queue"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "ota_updates",
                        "op": "==",
                        "value": true
                    },
                    {
                        "field": "code_signing",
                        "op": "!=",
                        "value": true
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "threat": {
            "title": "IoT Firmware Tampering Risk",
            "description": "Over-the-air (OTA) firmware updates are enabled without code signing, allowing attackers to push malicious firmware to IoT devices."
        },
        "risk": {
            "severity": "Critical",
            "likelihood": "Medium",
            "impact": "High",
            "risk_score": 82.5,
            "affected_assets": [
                "IoT Devices",
                "Patient Data"
            ],
            "business_impact": [
                "Device Compromise",
                "Patient Safety"
            ]
        },
        "mitigation": {
            "primary": "Implement code signing for all firmware updates with secure key management.",
            "defense_in_depth": [
                "Secure boot",
                "Device attestation",
                "Rollback protection"
            ],
            "verification": "Verify firmware signature validation on devices."
        },
        "references": [
            "OWASP IoT Top 10",
            "NIST IoT Security"
        ],
        "tags": [
            "iot",
            "firmware",
            "medical-device"
        ]
    },
    {
