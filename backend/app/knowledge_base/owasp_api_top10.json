[
    {
        "id": "OWASP-API-001",
        "category": "Elevation of Privilege",
        "resource_type": [
            "API"
        ],
        "detection": {
            "logic": {
                "operator": "OR",
                "conditions": [
                    {
                        "field": "authorization_model",
                        "op": "==",
                        "value": "none"
                    },
                    {
                        "field": "object_level_auth",
                        "op": "==",
                        "value": false
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "threat": {
            "title": "Broken Object Level Authorization (BOLA)",
            "description": "API endpoints do not validate that the requesting user is authorized to access the specific object. Attackers can manipulate object IDs to access other users' data."
        },
        "risk": {
            "severity": "Critical",
            "likelihood": "High",
            "impact": "High",
            "risk_score": 92.0,
            "affected_assets": [
                "User Data",
                "Business Objects"
            ],
            "business_impact": [
                "Data Breach",
                "Privacy Violation",
                "Regulatory Fines"
            ]
        },
        "mitigation": {
            "primary": "Implement object-level authorization checks on every API endpoint that accesses a data source using user-supplied IDs.",
            "defense_in_depth": [
                "ABAC policies",
                "Resource-based access control",
                "API gateway authorization"
            ],
            "verification": "Test with automated tools like AuthZ testing or manual IDOR testing."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A01:2021-Broken Access Control"
            ],
            "cwe": [
                "CWE-639"
            ],
            "nist_800_53": [
                "AC-3",
                "AC-6"
            ]
        },
        "tags": [
            "api",
            "authorization",
            "idor",
            "bola"
        ]
    },
    {
        "id": "OWASP-API-002",
        "category": "Spoofing",
        "resource_type": [
            "API"
        ],
        "detection": {
            "logic": {
                "operator": "OR",
                "conditions": [
                    {
                        "field": "auth_type",
                        "op": "==",
                        "value": "none"
                    },
                    {
                        "field": "auth_type",
                        "op": "==",
                        "value": "basic"
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "threat": {
            "title": "Broken Authentication",
            "description": "Authentication mechanisms are weak or missing, allowing attackers to compromise tokens, credentials, or exploit flaws to assume other users' identities."
        },
        "risk": {
            "severity": "Critical",
            "likelihood": "High",
            "impact": "High",
            "risk_score": 90.0,
            "affected_assets": [
                "User Accounts",
                "API Keys"
            ],
            "business_impact": [
                "Account Takeover",
                "Identity Theft"
            ]
        },
        "mitigation": {
            "primary": "Use industry-standard authentication (OAuth 2.0, OpenID Connect). Implement strong password policies and MFA.",
            "defense_in_depth": [
                "Token expiration",
                "Rate limiting on auth endpoints",
                "Credential stuffing protection"
            ],
            "verification": "Perform authentication testing including brute force and token manipulation."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A07:2021-Identification and Authentication Failures"
            ],
            "cwe": [
                "CWE-287",
                "CWE-307"
            ],
            "nist_800_53": [
                "IA-2",
                "IA-5",
                "IA-8"
            ]
        },
        "tags": [
            "api",
            "authentication",
            "brute-force"
        ]
    },
    {
        "id": "OWASP-API-003",
        "category": "Information Disclosure",
        "resource_type": [
            "API"
        ],
        "detection": {
            "logic": {
                "operator": "OR",
                "conditions": [
                    {
                        "field": "response_filtering",
                        "op": "==",
                        "value": false
                    },
                    {
                        "field": "field_level_auth",
                        "op": "==",
                        "value": false
                    }
                ]
            },
            "auto_detectable": false,
            "confidence": "medium"
        },
        "threat": {
            "title": "Broken Object Property Level Authorization",
            "description": "API returns excessive data properties that the user should not have access to. Lack of field-level filtering exposes sensitive attributes."
        },
        "risk": {
            "severity": "High",
            "likelihood": "Medium",
            "impact": "High",
            "risk_score": 78.0,
            "affected_assets": [
                "User PII",
                "Internal Metadata"
            ],
            "business_impact": [
                "Data Leakage",
                "Privacy Violation"
            ]
        },
        "mitigation": {
            "primary": "Implement response filtering to return only necessary fields. Use DTOs/view models to control API response shape.",
            "defense_in_depth": [
                "Field-level encryption",
                "Schema validation",
                "API response auditing"
            ],
            "verification": "Review API responses for unnecessary data exposure."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A01:2021-Broken Access Control"
            ],
            "cwe": [
                "CWE-213",
                "CWE-200"
            ],
            "nist_800_53": [
                "AC-3",
                "AC-4"
            ]
        },
        "tags": [
            "api",
            "data-exposure",
            "mass-assignment"
        ]
    },
    {
        "id": "OWASP-API-004",
        "category": "Denial of Service",
        "resource_type": [
            "API"
        ],
        "detection": {
            "logic": {
                "operator": "OR",
                "conditions": [
                    {
                        "field": "rate_limiting",
                        "op": "==",
                        "value": false
                    },
                    {
                        "field": "pagination",
                        "op": "==",
                        "value": false
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "high"
        },
        "threat": {
            "title": "Unrestricted Resource Consumption",
            "description": "API does not limit the number or size of resources a client can request. Attackers can exhaust server resources through excessive API calls or large payloads."
        },
        "risk": {
            "severity": "High",
            "likelihood": "High",
            "impact": "High",
            "risk_score": 82.0,
            "affected_assets": [
                "Server Resources",
                "API Availability"
            ],
            "business_impact": [
                "Service Outage",
                "Revenue Loss"
            ]
        },
        "mitigation": {
            "primary": "Implement rate limiting, request size limits, and pagination. Use API throttling at the gateway level.",
            "defense_in_depth": [
                "Query complexity limits",
                "Timeout enforcement",
                "Resource quotas per user"
            ],
            "verification": "Load test APIs to verify rate limiting and resource consumption controls."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A05:2021-Security Misconfiguration"
            ],
            "cwe": [
                "CWE-770",
                "CWE-400"
            ],
            "nist_800_53": [
                "SC-5",
                "SC-6"
            ]
        },
        "tags": [
            "api",
            "rate-limiting",
            "dos",
            "resource-exhaustion"
        ]
    },
    {
        "id": "OWASP-API-005",
        "category": "Elevation of Privilege",
        "resource_type": [
            "API"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "type",
                        "op": "in",
                        "value": [
                            "API",
                            "Service"
                        ]
                    },
                    {
                        "field": "function_level_auth",
                        "op": "==",
                        "value": false
                    }
                ]
            },
            "auto_detectable": false,
            "confidence": "medium"
        },
        "threat": {
            "title": "Broken Function Level Authorization",
            "description": "API does not enforce function-level access control. Regular users can access admin endpoints or perform privileged operations by guessing endpoint URLs."
        },
        "risk": {
            "severity": "Critical",
            "likelihood": "Medium",
            "impact": "High",
            "risk_score": 85.0,
            "affected_assets": [
                "Admin Functions",
                "System Configuration"
            ],
            "business_impact": [
                "Privilege Escalation",
                "System Compromise"
            ]
        },
        "mitigation": {
            "primary": "Implement role-based access control (RBAC) with explicit authorization checks on every function/endpoint.",
            "defense_in_depth": [
                "API gateway policy enforcement",
                "Admin endpoint isolation",
                "Audit logging for sensitive operations"
            ],
            "verification": "Test all admin endpoints with unprivileged users."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A01:2021-Broken Access Control"
            ],
            "cwe": [
                "CWE-285"
            ],
            "nist_800_53": [
                "AC-3",
                "AC-6"
            ]
        },
        "tags": [
            "api",
            "authorization",
            "privilege-escalation",
            "rbac"
        ]
    },
