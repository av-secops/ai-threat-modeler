    {
        "id": "OWASP-API-007",
        "category": "Tampering",
        "resource_type": [
            "API"
        ],
        "detection": {
            "logic": {
                "operator": "AND",
                "conditions": [
                    {
                        "field": "ssrf_protection",
                        "op": "==",
                        "value": false
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "medium"
        },
        "threat": {
            "title": "Server-Side Request Forgery (SSRF)",
            "description": "API accepts user-supplied URLs or resource identifiers without validation, allowing attackers to make the server send requests to internal resources or external systems."
        },
        "risk": {
            "severity": "High",
            "likelihood": "Medium",
            "impact": "High",
            "risk_score": 80.0,
            "affected_assets": [
                "Internal Services",
                "Cloud Metadata"
            ],
            "business_impact": [
                "Internal Network Access",
                "Credential Theft"
            ]
        },
        "mitigation": {
            "primary": "Validate and whitelist all user-supplied URLs. Block access to internal networks and cloud metadata endpoints.",
            "defense_in_depth": [
                "URL schema enforcement",
                "Network segmentation",
                "Egress filtering"
            ],
            "verification": "Test with SSRF payloads targeting internal services and cloud metadata endpoints."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A10:2021-Server-Side Request Forgery"
            ],
            "cwe": [
                "CWE-918"
            ],
            "nist_800_53": [
                "SC-7",
                "SI-10"
            ]
        },
        "tags": [
            "api",
            "ssrf",
            "injection",
            "server-side"
        ]
    },
    {
        "id": "OWASP-API-008",
        "category": "Combined",
        "resource_type": [
            "API",
            "Service"
        ],
        "detection": {
            "logic": {
                "operator": "OR",
                "conditions": [
                    {
                        "field": "security_headers",
                        "op": "==",
                        "value": false
                    },
                    {
                        "field": "cors_misconfigured",
                        "op": "==",
                        "value": true
                    }
                ]
            },
            "auto_detectable": true,
            "confidence": "medium"
        },
        "threat": {
            "title": "Security Misconfiguration",
            "description": "API has insecure default configurations, missing security headers, permissive CORS policy, or unnecessary HTTP methods enabled."
        },
        "risk": {
            "severity": "Medium",
            "likelihood": "High",
            "impact": "Medium",
            "risk_score": 65.0,
            "affected_assets": [
                "API Security Controls"
            ],
            "business_impact": [
                "Cross-Origin Attacks",
                "Information Leakage"
            ]
        },
        "mitigation": {
            "primary": "Harden API configurations: set restrictive CORS, enable security headers, disable debug mode, remove unnecessary HTTP methods.",
            "defense_in_depth": [
                "Automated configuration scanning",
                "Infrastructure-as-code templates",
                "Security baselines"
            ],
            "verification": "Scan API configuration with tools like OWASP ZAP or Postman security tests."
        },
        "mapped_controls": {
            "owasp_top_10": [
                "A05:2021-Security Misconfiguration"
            ],
            "cwe": [
                "CWE-16"
            ],
            "nist_800_53": [
                "CM-6",
                "CM-7"
            ]
        },
        "tags": [
            "api",
            "configuration",
            "cors",
            "headers"
        ]
    },
